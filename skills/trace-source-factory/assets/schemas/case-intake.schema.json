{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trace-source-factory/case-intake.schema.json",
  "title": "Source factory trace case intake",
  "type": "object",
  "required": ["case_id", "objective", "target_processes", "inputs"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "target_material": {"type": ["string", "null"]},
    "target_processes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "certification_requirements": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["original", "specification", "certificate", "trade", "historical", "other"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "preferred_regions": {"type": "array", "items": {"type": "string"}},
        "excluded_materials": {"type": "array", "items": {"type": "string"}},
        "browser_surfaces": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
